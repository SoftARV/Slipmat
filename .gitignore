/target
/sidecar/node_modules

# makepkg build output. The PKGBUILDs are source; everything makepkg creates
# beside them is not — including the ~330 MB it downloads.
/packaging/aur/*/src/
/packaging/aur/*/pkg/
/packaging/aur/*/*.pkg.tar.*
/packaging/aur/*/*.tar.gz
/packaging/aur/*/.SRCINFO
# The bare clone a -git PKGBUILD's source=('git+…') leaves behind. Named after
# the package rather than living under src/, so the rules above miss it.
/packaging/aur/*/tonearm/

# Flatpak build output
build-dir/
flatpak-repo/
.flatpak-builder/

# fetched on demand by packaging/flatpak/generate-sources.sh
packaging/flatpak/.flatpak-cargo-generator.py
Tonearm.flatpak
