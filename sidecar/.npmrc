# npm 12 disables git-type dependencies by default, and castLabs Electron is
# only distributed as a GitHub release — it is not on the npm registry. Without
# this, `npm install` fails with EALLOWGIT.
#
# `root` permits a git dep declared in OUR package.json only; a transitive
# dependency still cannot pull from git. Do not widen this to `all`.
#
# No allow-scripts entry is needed: castLabs ships no postinstall hook. The
# ~200 MB Chromium is fetched by an explicit `node node_modules/electron/
# install.js` step, which `make sidecar` runs. That is why `npm install` alone
# leaves you with a 14 MB node_modules and no binary.
#
# This file must live beside package.json (i.e. in sidecar/), not at the repo
# root: npm reads the project .npmrc from the directory it installs in.
allow-git=root
